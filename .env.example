# Opcional: sem .env usa SQLite (sqlite+aiosqlite:///./dev.db)
# Para PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/camelbox
# No Render, use a Internal Database URL do PostgreSQL em DATABASE_URL.

# Opcional em dev (gera UUID aleatório se não definido). Obrigatório em produção.
# JWT_SECRET=sua-chave-secreta-aqui

# IA / integrações externas
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# FREE_ANALYSES_LIMIT=3

# Pagamentos e email, se habilitados
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=

# Redis/Celery, apenas se processamento assíncrono for usado
# REDIS_URL=redis://localhost:6379/0
