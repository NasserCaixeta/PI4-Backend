# Ambiente: "development" ou "production"
# Em produção: desabilita /docs, ativa HSTS e Secure nos cookies
# APP_ENV=production

# Opcional: sem .env usa SQLite (sqlite+aiosqlite:///./dev.db)
# Para PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/camelbox
# No Render, use a Internal Database URL do PostgreSQL em DATABASE_URL.

# Opcional em dev (gera UUID aleatório se não definido). Obrigatório em produção.
# JWT_SECRET=sua-chave-secreta-aqui

# URL do frontend para CORS (obrigatório em produção).
# FRONTEND_URL=https://pi4-frontend-camelbox.pages.dev

# Origens adicionais separadas por vírgula (opcional, sobrescreve FRONTEND_URL para CORS)
# ALLOWED_ORIGINS=["https://pi4-frontend-camelbox.pages.dev"]

# IA / integrações externas
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# FREE_ANALYSES_LIMIT=3
# SUPER_ANALYSES_LIMIT=20

# Pagamentos e email, se habilitados
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUPER_PRICE_ID=
# STRIPE_MASTER_PRICE_ID=
# FRONTEND_URL=https://pi4-frontend-camelbox.pages.dev
# RESEND_API_KEY=

# Redis/Celery, apenas se processamento assíncrono for usado
# REDIS_URL=redis://localhost:6379/0
