# Copy to .env before running docker compose, then fill the integration keys you need.

APP_ENV=development
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=camelbox
POSTGRES_USER=camelbox
POSTGRES_PASSWORD=camelbox

# Used by docker-compose.prod.yml when Postgres and Redis are external.
# docker-compose.yml creates its own local DATABASE_URL/REDIS_URL from the services above.
DATABASE_URL=postgresql://user:password@db-host:5432/camelbox
REDIS_URL=redis://redis-host:6379/0

JWT_SECRET=change-me-local-docker-secret
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=local-dev
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUPER_PRICE_ID=
STRIPE_MASTER_PRICE_ID=
RESEND_API_KEY=
EMAIL_PROVIDER=console
REQUIRE_EMAIL_VERIFICATION=true
BREVO_API_KEY=
EMAIL_FROM=

FREE_ANALYSES_LIMIT=3
SUPER_ANALYSES_LIMIT=20
